<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:Label text="FOOD: 20" name="FoodLabel" style="-unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); color: rgb(255, 255, 255); font-size: 12px; -unity-text-align: upper-center; position: absolute; top: 18px; left: 0; right: 0; -unity-font-style: normal;" />
    <engine:VisualElement name="MainMenuPanel" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(10, 12, 20, 0.94); align-items: center; justify-content: center;">
        <engine:Label text="ROGUELIKE" style="color: rgb(255, 220, 120); font-size: 32px; -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); -unity-text-align: middle-center; margin-bottom: 48px;" />
        <engine:Button text="PLAY" name="PlayButton" style="width: 320px; height: 64px; margin-bottom: 20px; color: rgb(255, 255, 255); background-color: rgb(55, 95, 70); font-size: 16px; -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;);" />
        <engine:Button text="QUIT" name="MainMenuQuitButton" style="width: 320px; height: 64px; color: rgb(255, 255, 255); background-color: rgb(90, 45, 45); font-size: 16px; -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;);" />
    </engine:VisualElement>
    <engine:VisualElement name="PausePanel" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.82); align-items: center; justify-content: center;">
        <engine:Label text="PAUSED" style="color: rgb(255, 220, 120); font-size: 24px; -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); margin-bottom: 36px;" />
        <engine:Button text="RESUME" name="ResumeButton" style="width: 360px; height: 64px; margin-bottom: 16px; color: rgb(255, 255, 255); background-color: rgb(55, 95, 70); font-size: 14px; -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;);" />
        <engine:Button text="RESTART" name="RestartButton" style="width: 360px; height: 64px; margin-bottom: 16px; color: rgb(255, 255, 255); background-color: rgb(65, 75, 105); font-size: 14px; -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;);" />
        <engine:Button text="QUIT" name="PauseQuitButton" style="width: 360px; height: 64px; color: rgb(255, 255, 255); background-color: rgb(90, 45, 45); font-size: 14px; -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;);" />
    </engine:VisualElement>
    <engine:VisualElement name="GameOverPanel" style="position: absolute; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(0, 0, 0, 0.86); align-items: center; justify-content: center;">
        <engine:Label text="GAME OVER" name="GameOverMessage" style="color: rgb(255, 255, 255); font-size: 20px; -unity-font-style: bold; -unity-font-definition: url(&quot;project://database/Assets/Roguelike2D/TutorialAssets/Fonts/PressStart2P-Regular.ttf?fileID=12800000&amp;guid=b284a6525342f44599e9ce79e37c2d61&amp;type=3#PressStart2P-Regular&quot;); -unity-text-align: middle-center; white-space: normal;" />
    </engine:VisualElement>
</engine:UXML>
